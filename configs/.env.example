# ============================================================
# LumiBot 环境配置示例
# 使用方法：复制为项目根目录 .env 后填写真实值
#   cp configs/.env.example .env
# ============================================================

# 运行环境：dev（QQ 沙箱）/ prod（QQ 正式环境）
ENV=dev

# ---- QQ 开放平台机器人凭证（必填）----
# 在 https://q.qq.com 开放平台创建机器人后获取
QQ_APP_ID=
QQ_TOKEN=
QQ_SECRET=

# openapi 请求超时（可选，默认 5s）
# QQ_OPENAPI_TIMEOUT=5s

# 机器人调试模式：true 时开启 SDK 调试输出（生产环境请保持 false）
BOT_DEBUG=false

# ---- 内置 HTTP 服务（LumiAdmin 回调入口）----
HTTP_ADDR=:8080
# HTTP_READ_TIMEOUT=5s
# HTTP_WRITE_TIMEOUT=10s
# HTTP_IDLE_TIMEOUT=60s

# ---- 统一事件系统 ----
# 事件上报接口（POST /api/v1/events）允许的 API Key，逗号分隔支持多个
# 未配置时拒绝所有上报请求（安全优先）
EVENT_API_KEYS=test-key

# ---- 通知系统 ----
# 是否启用通知（事件 → QQ 通知）
NOTIFICATION_ENABLE=true
# 通知冷却时间（秒）：同一事件类型在窗口内重复事件只通知一次
NOTICE_COOLDOWN=300
# QQ_PRIVATE 渠道目标：管理员 QQ openid（必填，否则私聊通知被跳过）
NOTIFY_PRIVATE_TARGET=
# QQ_CHANNEL 渠道目标：子频道 ID（可选，频道通知用）
NOTIFY_CHANNEL_TARGET=

# ---- 日志 ----
# 级别：debug / info / warn / error
LOG_LEVEL=info
